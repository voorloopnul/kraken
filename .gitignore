# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Build output of packaging/appimage/build_appimage.sh
Kraken-*.AppImage
packaging/appimage/tools/

# Build output of packaging/macos/build_app.sh, which writes the disk image
# next to the AppImage's; the bundle it is packed from stays under build/
Kraken-*.dmg

# Vendored ghostty source (see README for build steps)
vendor/ghostty/
vendor/toolchain/

# JetBrains Mono download and its extraction; the faces the app actually
# loads are committed under kraken/ui/assets/fonts (see kraken/ui/fonts.py)
/fonts/
vendor/JetBrainsMono-*.zip

# Debug logs. `--debug` writes to ~/.kraken/logs by default, but it takes a
# path, and running from a checkout puts that path here (see DEBUG.md)
*.log

# macOS Finder metadata
.DS_Store
